# Ravi OS access
RAVI_OS_PIN=1234
RAVI_OS_AUTH_SECRET=replace-with-a-long-random-secret

# Geet reminder-only access
# SHA-256 of the numeric PIN. Default app fallback currently corresponds to 11114.
GEET_PIN_HASH=

# Google OAuth for Ravi OS runtime integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Ravi OS uses isolated ravi_os_* tables inside the existing Supabase project pvnfwippvojplzedbnba.
# Keep this server-side only. Never commit the value.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider abstraction (configure one or both later)
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
